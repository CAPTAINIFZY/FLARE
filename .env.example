# Database Configuration
POSTGRES_USER=flare
POSTGRES_PASSWORD=flare_password
POSTGRES_DB=flare_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# FastAPI Configuration
ENVIRONMENT=development
SECRET_KEY=your-super-secret-jwt-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Scraper Configuration (Optional - for rate limiting etc.)
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
SCRAPE_DO_TOKEN=0f737bcdd4d04085854df2da49a669e8a87e6d23cec
